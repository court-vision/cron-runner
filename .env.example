# Copy to .env and `source .env` before `go run .`. Never commit .env.
# Durations are Go time.ParseDuration strings — a bare number is silently
# ignored and the default is used.

# Data-platform origin (NOT the backend; jobs POST to /v1/internal/pipelines/*)
export BACKEND_URL=https://data.courtvision.dev
export PIPELINE_API_TOKEN=

export HTTP_PORT='8082'

export MAX_RETRIES='3'
export INITIAL_BACKOFF='2s'
export MAX_BACKOFF='30s'
export BACKOFF_FACTOR='2.0'
export REQUEST_TIMEOUT='30s'

export POLL_INITIAL_INTERVAL='5s'
export POLL_MAX_INTERVAL='30s'
export POLL_MAX_WAIT_TIME='15m'
export DRAIN_TIMEOUT='30s'

export LOG_LEVEL='info'
export LOG_JSON='true'
